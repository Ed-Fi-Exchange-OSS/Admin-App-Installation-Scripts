# Copy this file to .env and edit the values to match your deployment, then
# run ./run.ps1. Every variable maps onto a parameter of export-edorgs.ps1,
# import-edorgs.ps1, or cleanup-edorgs.ps1.
#
# The source ODS (ODS_* variables) and the target Admin App database (the
# unprefixed variables) are configured independently: they can live on
# different servers and even different engines.
#
# Passwords (ODS_DB_PASSWORD, ODS_POSTGRES_PASSWORD, ADMIN_APP_DB_PASSWORD,
# POSTGRES_APP_PASSWORD) may be left empty: run.ps1 and cleanup-edorgs.ps1
# prompt for the ones they need, with the input masked. Set them here only
# for unattended runs.

# --- Source: the EdFi_ODS database to export from ------------------------------
# Engine: mssql | pgsql
ODS_DB_ENGINE=mssql
# The ODS to export (e.g. EdFi_Ods_2026, EdFi_Ods_Populated_Template). Required.
ODS_DATABASE_NAME=
# mssql: server hosting the ODS
ODS_SQL_SERVER=tcp:localhost,1433
ODS_DB_USERNAME=sa
ODS_DB_PASSWORD=
# mssql: true = Windows integrated authentication (ODS_DB_PASSWORD not needed)
ODS_USE_INTEGRATED_SECURITY=false
# pgsql:
ODS_POSTGRES_HOST=localhost
ODS_POSTGRES_PORT=5432
ODS_POSTGRES_USER=postgres
ODS_POSTGRES_PASSWORD=
# true: run psql inside the ODS Docker stack's database container
ODS_USE_POSTGRES_DOCKER=false
ODS_POSTGRES_CONTAINER=ed-fi-db-ods

# --- Target: the Admin App application database ---------------------------------
# Engine: mssql | pgsql
DB_ENGINE=mssql
DATABASE_NAME=sbaa
# mssql: server hosting the Admin App database
SQL_SERVER=tcp:localhost,1433
ADMIN_APP_DB_USER=edfi_adminapp
ADMIN_APP_DB_PASSWORD=
# mssql: true = Windows integrated authentication (ADMIN_APP_DB_PASSWORD not needed)
USE_INTEGRATED_SECURITY=false
# pgsql:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_APP_USER=edfiadminapp
POSTGRES_APP_PASSWORD=
# true: run psql inside the Admin App Docker stack's database container
USE_POSTGRES_DOCKER=false
POSTGRES_CONTAINER=edfiadminapp-postgres

# --- Where the ed orgs land in the Admin App ------------------------------------
# The import attaches the ed orgs to an EXISTING tenant + ODS registration
# (create them first through the Admin App UI).
# Admin App tenant name ('default' unless the deployment renamed it).
TENANT_NAME=default
# Only needed when the same tenant name exists in more than one environment.
ENVIRONMENT_NAME=
# Which registered ODS (Admin App ods.dbName) to attach the ed orgs to. Blank =
# ODS_DATABASE_NAME, which is right whenever the registration used the real
# database name; only needed otherwise or when the tenant has several ODS rows.
ODS_DB_NAME=

# --- CSV ------------------------------------------------------------------------
# Where export-edorgs.ps1 writes and import-edorgs.ps1/cleanup-edorgs.ps1 read.
CSV_PATH=./edorgs.csv
